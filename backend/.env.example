# Database and graph
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/zerocopy
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# Read-only ERP integration. Never commit real secrets.
DEMO_PASSWORD=demo123
ERP_PROVIDER=sap
ERP_SYNC_INTERVAL_SECONDS=300

SAP_BASE_URL=https://your-sap-host.example
SAP_MATERIAL_ENDPOINT=/sap/opu/odata/sap/API_PRODUCT_SRV/A_Product
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=
SAP_TOKEN_URL=https://your-sap-host.example/oauth/token
SAP_FIELD_MAPPING={"Material":"legacy_code","MaterialDescription":"description","Manufacturer":"manufacturer","MaterialGroup":"category","BaseUnit":"unit","LastChangeDateTime":"source_updated_at"}

ORACLE_BASE_URL=https://your-oracle-host.example
ORACLE_MATERIAL_ENDPOINT=/fscmRestApi/resources/latest/items
ORACLE_CLIENT_ID=
ORACLE_CLIENT_SECRET=
ORACLE_TOKEN_URL=https://your-oracle-host.example/oauth/token
ORACLE_FIELD_MAPPING={"ItemNumber":"legacy_code","ItemDescription":"description","Manufacturer":"manufacturer","ItemClass":"category","PrimaryUOMValue":"unit","LastUpdateDate":"source_updated_at"}
